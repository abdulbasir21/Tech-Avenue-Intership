# Copy to server/.env and fill in. NEVER commit server/.env
PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/irop_dev?retryWrites=true&w=majority
MONGODB_URI_TEST=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/irop_test?retryWrites=true&w=majority

JWT_SECRET=your-long-random-secret-here
JWT_EXPIRES_IN=1d
CLIENT_ORIGIN=http://localhost:5173
