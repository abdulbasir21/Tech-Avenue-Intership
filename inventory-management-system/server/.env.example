# PostgreSQL connection string via Neon pooler (used for application queries)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct PostgreSQL connection string without pooler (used by Prisma Migrate)
DATABASE_URL_UNPOOLED="postgresql://username:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Server & Auth Configuration
PORT=5000
JWT_SECRET="replace_with_a_long_random_secret_at_least_32_chars"
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173

# Initial Admin Seed Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
